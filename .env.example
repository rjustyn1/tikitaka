# Browser/server
HOST=0.0.0.0
PORT=3000
PUBLIC_PORT=3000
LOG_LEVEL=info
# Required whenever production listens beyond loopback. Use 24+ random
# characters and enter the same token in the browser unlock screen.
APP_AUTH_TOKEN=replace-with-a-long-random-demo-token

# Volcengine Ark. ARK_MODEL is an endpoint/model ID that supports the
# OpenAI-compatible Responses API, for example ep-xxxxxxxx.
ARK_API_KEY=replace-with-your-ark-api-key
ARK_MODEL=ep-replace-with-your-endpoint-id
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Governed memory pipeline.
# Master switch. false restores the exact baseline (no group/memory features).
MEMORY_ENABLED=true
# Which extractor turns a finished task into memory notes:
#   ark  = real Ark model (task-derived notes; needs ARK_* above to work)
#   fake = deterministic offline canned notes (tests/offline demo)
#   off  = produce no notes
# Leave unset to use the default Ark extractor.
# How many plan nodes of one group task may run at once. 1 is strictly
# sequential. Safety does not depend on this: the scheduler also refuses to
# overlap two nodes held by one Agent, or two nodes whose runtime locks
# overlap in the shared ./code tree.
GROUP_MAX_PARALLEL_NODES=4

MEMORY_EXTRACTOR=ark
# Consolidator model-call timeout. A five-node task prompt can take ~35s, so the
# 30000 code default is too low for real runs — keep this generous.
MEMORY_EXTRACT_TIMEOUT_MS=120000
# Force every skill/note through human review (high-security posture).
REVIEW_ALL_SKILLS=false
# Where landed skills are written inside each Agent workspace. Verified against
# @openai/codex 0.111.0 (scope: repo). .codex/skills also works; never
# $CODEX_HOME/skills (that is global to every Agent).
SKILLS_DIR=.agents/skills

# --- Topic segmentation (KL_Divergence) --------------------------------------
# Memory is consolidated per TOPIC SEGMENT -- a run of consecutive group tasks
# that stayed on one subject -- not per task. Boundaries are detected with
# Jensen-Shannon divergence over the human prompts only.
# Drift score above which the subject is considered changed. Calibrated against
# sample prompts, not guessed; see memory/topic-drift.ts.
MEMORY_TOPIC_DRIFT_THRESHOLD=0.90
# Hard caps that close a segment regardless of drift, so a slow subject creep
# still gets consolidated.
MEMORY_SEGMENT_MAX_TASKS=8
MEMORY_SEGMENT_MAX_CHARS=120000
# A segment left untouched this long is closed on the next group read.
MEMORY_SEGMENT_IDLE_MS=1800000

# --- Note recognition / routing (feat/memory-consolidator) -------------------
# Decides WHICH Agents receive each note. Extraction no longer picks recipients.
#   fake  = deterministic offline routing (default; keeps npm run check offline)
#   ark   = embeddings via the Ark API
#   sbert = local CPU SBERT model through scripts/embed-recognizer.py
#   off   = no routing
MEMORY_RECOGNIZER=fake
# Local SBERT bridge. Only read when MEMORY_RECOGNIZER=sbert. The checkpoint
# ships via Git LFS at data/recognition/model, so `git lfs pull` is enough;
# the Python deps are per-machine (apps/server/requirements-sbert.txt).
MEMORY_SBERT_PYTHON=python3
# MEMORY_SBERT_MODEL_DIR=/absolute/path/to/data/recognition/model
# MEMORY_SBERT_BRIDGE=/absolute/path/to/scripts/embed-recognizer.py
MEMORY_EMBEDDING_TIMEOUT_MS=30000
# Similarity floor for routing a note to an Agent / to an existing skill.
# Below the Agent floor the best single match is still taken, but flagged as a
# fallback and sent to human review rather than auto-granted.
# 0.72 is the value the promoted v1 checkpoint was calibrated at under the
# false-positive-priority policy (MANIFEST_RECOGNITION.md). It is the operating
# contract and belongs with that checkpoint; the bare code fallback in
# config.ts is lower and applies only when this key is unset.
MEMORY_RECOGNITION_AGENT_THRESHOLD=0.72
MEMORY_RECOGNITION_SKILL_THRESHOLD=0.45
# Automatic grants stay OFF until a maintainer has reviewed an independent
# holdout and recalibrated against human labels. While false, SBERT threshold
# matches are review-only. See manifest/MANIFEST_RECOGNITION.md.
MEMORY_AUTO_GRANT_ENABLED=false

# Runtime paths (Docker defaults are already correct).
APP_DATA_DIR=/app/data
AGENT_WORKSPACE_ROOT=/app/workspaces
CODEX_HOME=/app/codex-home
CODEX_BIN=codex

# Codex runs inside the dedicated ECS/container boundary. Startup keeps
# workspace-write when Landlock is supported and falls back to
# danger-full-access inside the outer container on kernels without Landlock.
# The fallback has no per-Agent filesystem isolation; use a scoped demo model
# key and do not place unrelated credentials or data in this POC.
CODEX_SANDBOX_MODE=workspace-write
CODEX_TIMEOUT_MS=600000
CODEX_MAX_OUTPUT_BYTES=2097152

# Runtime provider. The ECS/Compose image uses local-process because Codex is
# installed in the application container. scripts/start-local-poc.sh overrides
# this to container and starts a disposable Docker/Colima/Podman Runtime.
RUNTIME_PROVIDER=local-process
CONTAINER_ENGINE=docker
CONTAINER_RUNTIME_IMAGE=volc-agent-runtime:local
# Optional build mirrors for networks that cannot reach Docker Hub or
# deb.debian.org. Leave empty on normal networks.
CONTAINER_RUNTIME_BASE_IMAGE=node:22-bookworm-slim
CONTAINER_APT_MIRROR=
CONTAINER_APT_SECURITY_MIRROR=
# Optional extra tools, for example append: python3 build-essential
CONTAINER_RUNTIME_APT_PACKAGES=ca-certificates git ripgrep
CONTAINER_CPU_LIMIT=2
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_PIDS_LIMIT=256
RUNTIME_INSTANCE_ID=default
# CONTAINER_USER is filled with the host UID:GID by start-local-poc.sh.
# CONTAINER_USER=1000:1000
