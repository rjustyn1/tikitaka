iew, and before any write&lt;br&gt;if safety itself errors, it quarantines&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#00706B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=76;spacingTop=16;fontSize=15;fontStyle=1;fontColor=#0F1A1B;" vertex="1" parent="1"><mxGeometry x="260" y="816" width="350" height="96" as="geometry" /></mxCell><mxCell id="n6" value="6" style="ellipse;html=1;fillColor=#00706B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="804" width="25" height="25" as="geometry" /></mxCell><mxCell id="s7" value="Human decides&lt;br&gt;&lt;span style='font-size:10px;color:#8B9C9A;font-weight:normal'&gt;severe &amp;#183; redacted &amp;#183; quarantined&lt;br&gt;fallback routing &amp;#183; any new skill&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#9A6108;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=76;spacingTop=16;fontSize=15;fontStyle=1;fontColor=#0F1A1B;" vertex="1" parent="1"><mxGeometry x="260" y="926" width="350" height="96" as="geometry" /></mxCell><mxCell id="n7" value="7" style="ellipse;html=1;fillColor=#00706B;strokeColor=none;fontColor=#FFFFFF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="248" y="914" width="25" height="25" as="geometry" /></mxCell><mxCell id="s8" value="Write the file&lt;br&gt;&lt;span style='font-size:10px;color:#8B9C9A;font-weight:normal'&gt;severe &amp;#8594; AGENTS.md&lt;br&gt;normal &amp;#8594; .agents/skills/&amp;#8230;/SKILL.md&lt;/span&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;strokeColor=#00706B;strokeWidth=2;fillColor=#FFFFFF;align=left;verticalAlign=top;spacingLeft=76;spacingTop=16;fontSize=15;fontStyle=1;fontColor=#0F1A1B;" vertex="1" parent="1"><mxGeometry x="260" y="1100" width="350" height="96" as="geometry" /></mxCell><mxCell id="n8" value="8" style="ellipse;html=1;fillColor=#00706B;strokeColor=none;fontColor=#FFFFFF