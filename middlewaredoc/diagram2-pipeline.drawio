" height="13" as="geometry" /></mxCell><mxCell id="lg1t" value="what moves on" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6E6E;" vertex="1" parent="1"><mxGeometry x="684" y="148" width="120" height="16" as="geometry" /></mxCell><mxCell id="lg2" value="" style="rounded=1;arcSize=25;html=1;fillColor=none;strokeColor=#A83C27;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="150" width="18" height="13" as="geometry" /></mxCell><mxCell id="lg2t" value="what falls out" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6E6E;" vertex="1" parent="1"><mxGeometry x="824" y="148" width="120" height="16" as="geometry" /></mxCell><mxCell id="lg3" value="" style="rounded=1;arcSize=25;html=1;fillColor=none;strokeColor=#9A6108;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="944" y="150" width="18" height="13" as="geometry" /></mxCell><mxCell id="lg3t" value="a human decides" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#5B6E6E;" vertex="1" parent="1"><mxGeometry x="968" y="148" width="130" height="16" as="geometry" /></mxCell><mxCell id="howto" value="&lt;b&gt;Diagram 2 &amp;#8212; the memory pipeline&lt;/b&gt;&lt;br&gt;&lt;br&gt;This is step 7 of Diagram 1, opened up. Nine stages, one spine.&lt;br&gt;Middle column = the data object leaving each stage. Right column = what falls out, and why.&lt;br&gt;&lt;br&gt;&lt;b&gt;Logos&lt;/b&gt; &amp;#8212; the three dashed squares (Ark, Py, Rct) are placeholders. Drag a real .svg/.png on, or select &amp;#8594; Ctrl/Cmd+E &amp;#8594; &lt;i&gt;shape=image;image=&amp;#8230;&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Watch this claim:&lt;/b&gt; the Consolidator's drop-out does NOT join the red rail. Nothing was extracted, so no note was withheld from anyone. Only stages 4, 5 and 7 produce real denials." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFFDF5;strokeColor=#9A6108;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#5B6E6E;" vertex="1" parent="1"><mxGeometry x="180" y="1350" width="640" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>