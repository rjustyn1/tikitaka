node_modules/
dist/
.env
.env.production
.data/
.local/
# Training data, datasets and superseded checkpoints stay out of Git.
# EXCEPTION: the promoted recognition checkpoint ships via Git LFS, so a
# plain clone can run MEMORY_RECOGNIZER=sbert with no out-of-band transfer.
data/*
!data/recognition
data/recognition/*
!data/recognition/model
# epoch-1 is a byte-identical copy of the promoted model; one is enough.
data/recognition/model/checkpoints/
scripts_ignored/
workspaces/
codex-home/
coverage/
*.log
*.tsbuildinfo
.DS_Store
deploy/volcengine/.terraform/
deploy/volcengine/*.tfstate*
deploy/volcengine/terraform.tfvars

# Playwright MCP session artifacts (accessibility-tree page snapshots).
# Regenerated on every browser-automation run; scratch output, not source.
.playwright-mcp/

# Ad-hoc UI QA screenshots dropped at the repo root.
# Scoped to the root on purpose: docs/assets/ holds real documentation images.
/*.png

# Local Python venv for the SBERT recognition bridge. Provisioned per machine
# from apps/server/requirements-sbert.txt; never committed (torch alone is
# 322 MB, well past GitHub's 100 MB per-file limit).
.venv-recognition/
!data/drift-model/
.codex-home/
